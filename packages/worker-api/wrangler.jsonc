{
  "name": "dji-arcgis-middleware",
  "main": "src/index.ts",
  "compatibility_date": "2024-07-25",
  "compatibility_flags": ["nodejs_compat"],

  // D1 Database
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dji-middleware-db",
      "database_id": "8557cd76-3832-435c-a6eb-135ac899c3ab"
    }
  ],

  // R2 Object Storage (drone media)
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "dji-media"
    }
  ],

  // KV Namespace (sessions, cached tokens)
  "kv_namespaces": [
    {
      "binding": "SESSION_STORE",
      "id": "36c33d6599394e07a956c640e287c314"
    }
  ],

  // Custom domain — uncomment after adding domain to Cloudflare DNS
  // "routes": [
  //   { "pattern": "djidrone.pedrorualves.eu", "custom_domain": true }
  // ],

  // Secrets (set via `wrangler secret put`):
  // JWT_SECRET, WEBHOOK_SECRET, ENCRYPTION_KEY,
  // DJI_APP_ID, DJI_APP_KEY, DJI_APP_LICENSE,
  // R2_ACCESS_KEY_ID, R2_ACCESS_KEY_SECRET, R2_ACCOUNT_ID,
  // EMQX_API_KEY, EMQX_API_SECRET

  "dev": {
    "port": 8787
  }
}
